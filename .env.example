# Conexión a Base de Datos PostgreSQL en Docker (dentro de Docker: house_crm_postgres:5432)
DATABASE_URL=postgresql://postgres:postgres@house_crm_postgres:5432/house_crm
DATABASE_SSL=false

# URLs del ecosistema Munirix
# Web: https://munirix.net | Dashboard Clientes: https://client.munirix.net | App & Webhooks: https://app.munirix.net
NEXT_PUBLIC_WEB_URL=https://munirix.net
NEXT_PUBLIC_CLIENT_URL=https://client.munirix.net
NEXT_PUBLIC_APP_URL=https://app.munirix.net
NEXTAUTH_URL=https://client.munirix.net
CLIENT_NEXTAUTH_URL=https://client.munirix.net
ADMIN_NEXTAUTH_URL=https://app.munirix.net
WEBHOOK_BASE_URL=https://app.munirix.net

# Autenticación NextAuth y Cifrado AES-256-GCM (claves BYOK y tokens OAuth)
NEXTAUTH_SECRET=tu_secreto_aqui
ENCRYPTION_KEY=cambia_esta_clave_de_32_caracteres_en_produccion

# Meta Webhooks & Integración Global (WhatsApp Cloud API / Instagram)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=house_crm_verify_token_2026

# Evolution API (WhatsApp para clientes de bajo consumo — también configurable por Tenant en UI)
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_INSTANCE_NAME=AdrielsSystems
EVOLUTION_API_KEY=

# Proveedores LLM Backend & Admin (Defaults: Gemini y DeepSeek; Tenants soportan BYOK)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google OAuth 2.0 (Sign-In / One Tap + Google Workspace por Tenant + Correo del Sistema)
# Origen JS autorizado: https://client.munirix.net
# URIs de redirección autorizados:
#   - https://client.munirix.net/api/auth/callback/google
#   - https://client.munirix.net/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=https://client.munirix.net/api/integrations/google/callback
GOOGLE_REFRESH_TOKEN_SYSTEM=
SYSTEM_GMAIL_FROM=adriels.systems@gmail.com

# Worker de Automatizaciones (Recordatorios 24h/2h, Seguimiento 15/30d)
WORKER_POLL_INTERVAL_MS=15000
